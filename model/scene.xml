<?xml version="1.0"?>
<mujoco model="so101_cube_to_box">
  <!--
    The fetch script places TheRobotStudio's so101_new_calib.xml and
    its assets/ directory beside this file. This project-authored scene
    then adds the table, cube, and open-top box.

    NOTE (reachability): the SO-101 shoulder_pan is limited to +-110 deg and
    the arm faces +X. The task is therefore placed in FRONT of the arm (+X).
    Earlier -X positions sat behind the arm, outside the pan limit, so no IK
    solution existed and the cube could not be reached.
  -->
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="145" elevation="-32"/>
  </visual>

  <asset>
    <!-- User-supplied STLs are in millimetres; MuJoCo works in metres. -->
    <mesh name="task_cube_mesh" file="../task_assets/cube.stl" scale="0.001 0.001 0.001"/>
    <mesh name="task_box_mesh" file="../task_assets/box.stl" scale="0.001 0.001 0.001"/>
    <material name="cube_mat" rgba="0.8 0.12 0.10 1"/>
    <material name="box_mat" rgba="0.12 0.32 0.75 1"/>
    <material name="table_mat" rgba="0.46 0.47 0.50 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 0 1.0" dir="0 0 -1" directional="true"/>

    <!-- Table top is z=0. The arm base is at the world origin and the table
         is shifted forward so the base sits at the table's NEAR edge, with the
         work surface extending into the arm's reachable zone (+X). -->
    <geom name="table" type="box" pos="0.19 0.0 -0.020" size="0.21 0.26 0.020" rgba="0.90 0.92 0.95 1"
          material="table_mat" friction="1.2 0.01 0.001"/>

    <!-- Dynamic 30 mm cube. STL is visual; box primitive is stable collision. -->
    <body name="cube" pos="0.18 0.06 0.015">
      <freejoint name="cube_freejoint"/>
      <geom name="cube_visual" type="mesh" mesh="task_cube_mesh" material="cube_mat"
            contype="0" conaffinity="0" group="2"/>
      <geom name="cube_collision" type="box" size="0.015 0.015 0.015"
            mass="0.030" friction="1.3 0.008 0.0002" rgba="0 0 0 0" group="3"/>
    </body>

    <!--
      User box STL is rendered exactly. For physics we use five simple box
      primitives instead of the STL convex hull, so the opening stays open.
    -->
    <body name="task_box" pos="0.20 -0.10 0">
      <geom name="box_visual" type="mesh" mesh="task_box_mesh" material="box_mat"
            contype="0" conaffinity="0" group="2"/>
      <geom name="box_floor" type="box" pos="0 0 0.0015" size="0.050 0.050 0.0015"
            friction="1.0 0.01 0.001" rgba="0.12 0.32 0.75 0.20" group="3"/>
      <geom name="box_wall_xp" type="box" pos="0.0475 0 0.010" size="0.0025 0.050 0.010"
            friction="1.0 0.01 0.001" rgba="0.12 0.32 0.75 0.20" group="3"/>
      <geom name="box_wall_xn" type="box" pos="-0.0475 0 0.010" size="0.0025 0.050 0.010"
            friction="1.0 0.01 0.001" rgba="0.12 0.32 0.75 0.20" group="3"/>
      <geom name="box_wall_yp" type="box" pos="0 0.0475 0.010" size="0.045 0.0025 0.010"
            friction="1.0 0.01 0.001" rgba="0.12 0.32 0.75 0.20" group="3"/>
      <geom name="box_wall_yn" type="box" pos="0 -0.0475 0.010" size="0.045 0.0025 0.010"
            friction="1.0 0.01 0.001" rgba="0.12 0.32 0.75 0.20" group="3"/>
    </body>
  </worldbody>

  <!--
    SIM-ONLY grasp helper. When the gripper closes we activate this weld, which
    locks the cube rigidly to the gripper at its current relative pose, so it
    rides along with NO swing (adhesion only pulls softly, so the cube dangles
    and swings). On release we deactivate it. Like adhesion, this does NOT
    transfer to the real SO-101 -- there the jaw friction holds the cube. The
    relative pose is overwritten at grab time, so the compile-time value here
    does not matter; active="false" keeps it off until we grab.
  -->
  <equality>
    <weld name="grip_weld" body1="gripper" body2="cube" active="false"
          solref="0.02 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>